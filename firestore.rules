rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() { return isSignedIn(); }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 4 &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             (!('name' in data.keys()) || (data.name is string && data.name.size() <= 200)) &&
             (!('imageUrl' in data.keys()) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             (!('role' in data.keys()) || (data.role in ['user', 'admin']));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isVerifiedUser() &&
                    isValidId(userId) &&
                    request.auth.uid == userId &&
                    isValidUser(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    incoming().keys().size() <= 7 &&
                    (!('role' in incoming().keys()) || incoming().role == 'user'); // Cannot create admin

      allow update: if isVerifiedUser() &&
                    request.auth.uid == userId &&
                    isValidUser(incoming()) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    (
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'imageUrl', 'updatedAt'])
                    );
    }
  }
}
